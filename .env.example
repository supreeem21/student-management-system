# Darbar Tech — environment variables
#
# Copy this file to .env.local and fill in real values before
# running the app. No secrets are currently required to run the
# app locally; this documents the production URL used for SEO
# metadata, sitemaps, and robots.txt (see app/layout.tsx,
# app/sitemap.ts, app/robots.ts).

NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
